  "query": "\n        INSERT INTO podcast (\n            id,\n            feed_url,\n            title,\n            image_url,\n            description,\n            author\n        )\n        VALUES (?, ?, ?, ?, ?, ?)\n        ON CONFLICT(id) DO UPDATE SET\n            title = excluded.title,\n            image_url = excluded.image_url,\n            description = excluded.description,\n            author = excluded.author\n        RETURNING\n            id as \"id!: uuid::Uuid\",\n            feed_url as \"feed_url!\",\n            title as \"title!\",\n            image_url,\n            description,\n            author\n        ",
